# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file -- it is listed in .gitignore.

# Canvas personal access token (Canvas -> Account -> Settings -> New Access Token)
CANVAS_API_TOKEN=paste_your_canvas_token_here

# Base URL of your Canvas instance (no trailing slash)
CANVAS_BASE_URL=https://boisestatecanvas.instructure.com

# Port the local web server listens on
PORT=3000
